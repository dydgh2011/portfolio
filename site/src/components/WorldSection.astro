---
// One page section on the map (site/scenes/world.json, edit with /editor in dev):
// its scene band (with the title) and its content zone (with the content).
//
// The zone stretches to its content: its repeat rows are tiled between the top and
// bottom parts, and a small script rounds the height up to whole rows so tiles are
// never cut. A section with no zone in the map still renders, just without scenery.
//
// Actors (knight, animals) live in bands, and are clipped to their band (see bandOfActor).
//   walk:   from → to along `row`, then up `up` rows (negative = down), then fades out
//   wander: back and forth between from and to, flipping when it turns
//   path:   through points [[col, row, pause?], ...] at `speed` tiles/s, then starts over
//
// Lights (see LIGHT_TYPES in world.mjs) also live in bands: an optional sprite (flame frames
// animate) drawn on the map, and a soft glow that only adds light (blend: screen). The glow
// is not clipped to the band, so it spills softly over the zones next to it.
import {
  bandOfActor,
  bandOfFireflies,
  bandOfLight,
  FIREFLY_BLINK,
  fireflyLifeKeys,
  fireflyTracks,
  layoutWorld,
  LIGHTS_SHEET_COLS,
  pathTimeline,
  PX,
  resolveFireflies,
  resolveLight,
} from '../../scripts/world.mjs';
import lightSheet from '../assets/ui/lights.png?url';
import { tileStyle, type TileRef } from '../lib/sprites';

interface Actor {
  sprite: TileRef;
  type: 'walk' | 'wander' | 'path';
  row: number;
  from: number;
  to: number;
  up?: number;
  duration: number;
  points?: [number, number, number?][];
  speed?: number;
  delay?: number;
  hero?: boolean;
}
interface World {
  cols: number;
  rows: number;
  zones?: unknown[];
  actors?: Actor[];
  fireflies?: Record<string, number | string>[];
  lights?: { type: string; col: number; row: number; color?: string; radius?: number; intensity?: number; flicker?: boolean | 'breathe' }[];
}

interface Props {
  id: string; // zone id (about, projects, ..., footer) or "end" for the last band
  as?: 'section' | 'footer' | 'div';
  class?: string;
  labelledby?: string;
  stop?: boolean; // a stop for keyboard jumps (Space / arrows, see Base.astro)
}

const worlds = import.meta.glob<World>('../../scenes/world.json', { eager: true, import: 'default' });
const images = import.meta.glob<string>('../assets/ui/world-*.png', { eager: true, query: '?url', import: 'default' });
const img = (file: string) => images[`../assets/ui/${file}`];

const { id, as: Tag = 'section', class: className, labelledby, stop } = Astro.props;
const world = worlds['../../scenes/world.json'];
const layout = world ? layoutWorld(world) : null;
const band = layout?.bands.find((b) => b.id === id && b.to >= b.from);
const zone = layout?.zones.find((z) => z.id === id);
const width = (world?.cols ?? 0) * PX;

const bandImage = band && img(`world-band-${id}.png`);
const bandRows = band ? band.to - band.from + 1 : 0;
const actors = band && layout ? (world?.actors ?? []).filter((a) => bandOfActor(a, layout.bands) === band) : [];

const lights = band && layout ? (world?.lights ?? []).filter((l) => bandOfLight(l, layout.bands) === band).map(resolveLight) : [];
const r1 = (n: number) => Math.round(n * 1000) / 1000;

// Fireflies: per firefly a loop (keyframes), a life cycle (per group) and a blink (shared).
const fireflies = band && layout
  ? (world?.fireflies ?? []).filter((g) => bandOfFireflies(g, layout.bands) === band).map((g) => ({ g: resolveFireflies(g), tracks: fireflyTracks(g), life: fireflyLifeKeys(g) }))
  : [];
const pct = (f: number) => `${r1(f * 100)}%`;
const fireflyCss = fireflies
  .map(({ tracks, life }, gi) => {
    const lifeKf = `@keyframes ff-life-${id}-${gi}{${life.map(([f, o]) => `${pct(f)}{opacity:${r1(o)}}`).join('')}}`;
    const paths = tracks.map((t, i) => {
      const steps = t.points.map(([x, y], k) => `${pct(k / (t.points.length - 1))}{transform:translate(${r1(x * PX)}px,${r1((y - band!.from) * PX)}px)}`).join('');
      return `@keyframes ff-path-${id}-${gi}-${i}{${steps}}`;
    });
    return lifeKf + paths.join('');
  })
  .join('') + (fireflies.length ? `@keyframes ff-blink{${FIREFLY_BLINK.map(([f, o]) => `${pct(f)}{opacity:${o}}`).join('')}}` : '');
const sheetSize = `${LIGHTS_SHEET_COLS * PX}px ${2 * PX}px`;
const frameAt = (index: number) => `-${(index % LIGHTS_SHEET_COLS) * PX}px -${Math.floor(index / LIGHTS_SHEET_COLS) * PX}px`;
const rgba = (hex: string, a: number) => {
  const h = hex.length === 4 ? hex.replace(/\w/g, (c) => c + c) : hex;
  return `rgba(${[1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16)).join(',')},${r1(a)})`;
};
// Spread the flicker so neighbouring fires don't pulse together.
const phase = (l: { col: number; row: number }) => -(((l.col * 7 + l.row * 13) % 17) / 10);

// Path actors get their own keyframes (positions in px inside the band).
const pathCss = actors
  .map((a, i) => ({ a, i }))
  .filter(({ a }) => a.type === 'path')
  .map(({ a, i }) => {
    const { total, frames } = pathTimeline(a.points, a.speed);
    const at = (x: number, y: number, flip: boolean) =>
      `transform:translate(${r1(x * PX)}px,${r1((y - band!.from) * PX)}px) scaleX(${flip ? -1 : 1})`;
    const move = frames.map((f) => `${r1((f.t / total) * 100)}%{${at(f.x, f.y, f.flip)}}`).join('');
    const fade = Math.min(10, (0.3 / total) * 100);
    return `@keyframes path-${id}-${i}{${move}0%{opacity:0}${r1(fade)}%{opacity:1}${r1(100 - fade)}%{opacity:1}100%{opacity:0}}`;
  })
  .join('');
const pathStart = (a: Actor) => {
  const [x, y] = a.points?.[0] ?? [0, band?.from ?? 0];
  return `transform:translate(${x * PX}px,${(y - (band?.from ?? 0)) * PX}px)`;
};
const pathTotal = (a: Actor) => pathTimeline(a.points, a.speed).total;

// Map sizes on the page scale with --map-tile (one tile: 32 px, smaller on narrow screens).
const mapWidth = `calc(${world?.cols ?? 0} * var(--map-tile))`;
const parts = zone && {
  top: zone.repeatFrom - zone.from,
  natural: zone.to - zone.from + 1,
  images: [
    zone.repeatFrom > zone.from && `url(${img(`world-zone-${id}-top.png`)}) center top / ${mapWidth} auto no-repeat`,
    zone.to > zone.repeatTo && `url(${img(`world-zone-${id}-bottom.png`)}) center bottom / ${mapWidth} auto no-repeat`,
    `url(${img(`world-zone-${id}-mid.png`)}) center calc(${zone.repeatFrom - zone.from} * var(--map-tile)) / ${mapWidth} auto repeat-y`,
  ].filter(Boolean),
};
const hasTitle = Astro.slots.has('title');
---

<Tag id={id === 'end' ? undefined : id} class:list={['world-section', className, { plain: !zone && id !== 'end' }]} aria-labelledby={labelledby} data-stop={stop ? '' : undefined}>
  {
    bandImage && (
      <div class="band" style={`height:calc(${bandRows} * var(--map-tile));background-image:url(${bandImage});background-size:calc(${world!.cols} * var(--map-tile)) auto`}>
        <div class="band-map" style={`width:${width}px;height:${bandRows * PX}px`} aria-hidden="true">
          {pathCss && <style is:inline set:html={pathCss} />}
          {actors.map((a, i) => (
            a.type === 'path' ? (
            <span
              class:list={['actor', 'path', { hero: a.hero }]}
              style={[
                pathStart(a),
                `animation-name:path-${id}-${i}`,
                `animation-duration:${r1(pathTotal(a))}s`,
                `animation-delay:${a.delay ?? 0}s`,
              ].join(';')}
            >
              <span class="tile" style={`${tileStyle(a.sprite, 2)};width:${PX}px;height:${PX}px`} />
            </span>
            ) : (
            <span
              class:list={['actor', a.type, { hero: a.hero }]}
              style={[
                `--tile:${PX}px`,
                `--row:${a.row - band!.from}`,
                `--from:${a.from * PX}px`,
                `--to:${a.to * PX}px`,
                `--up:${(a.up ?? 0) * PX}px`,
                `animation-duration:${a.duration}s`,
                `animation-delay:${a.delay ?? 0}s`,
              ].join(';')}
            >
              <span class="tile" style={`${tileStyle(a.sprite, 2)};width:${PX}px;height:${PX}px`} />
            </span>
            )
          ))}
          {lights.map((l) => [
            l.frames.length > 0 && (
              <span
                class:list={['light-sprite', { lit: l.frames.length > 1 }]}
                style={[
                  `left:${l.col * PX}px`,
                  `top:${(l.row - band!.from) * PX}px`,
                  `background-image:url(${lightSheet})`,
                  `background-size:${sheetSize}`,
                  `background-position:${frameAt(l.frames[0])}`,
                  l.frames.length > 1 && `--frames:${l.frames.length};--x0:-${(l.frames[0] % LIGHTS_SHEET_COLS) * PX}px;--y0:-${Math.floor(l.frames[0] / LIGHTS_SHEET_COLS) * PX}px`,
                  `animation-delay:${phase(l)}s`,
                ].filter(Boolean).join(';')}
              />
            ),
            l.below !== undefined && (
              <span
                class="light-sprite"
                style={`left:${l.col * PX}px;top:${(l.row - band!.from + 1) * PX}px;background-image:url(${lightSheet});background-size:${sheetSize};background-position:${frameAt(l.below)}`}
              />
            ),
          ])}
        </div>
        {(lights.length > 0 || fireflies.length > 0) && (
          <div class="band-lights" style={`width:${width}px;height:${bandRows * PX}px`} aria-hidden="true">
            {fireflyCss && <style is:inline set:html={fireflyCss} />}
            {fireflies.map(({ g, tracks }, gi) =>
              tracks.map((t, i) => (
                <span
                  class="firefly"
                  style={[
                    `animation-name:ff-path-${id}-${gi}-${i},ff-life-${id}-${gi}`,
                    `animation-duration:${r1(t.period)}s,${r1(t.cycle)}s`,
                    `animation-delay:${r1(t.periodDelay)}s,${r1(t.cycleDelay)}s`,
                  ].join(';')}
                >
                  <span
                    class="ff-light"
                    style={[
                      `--ff-size:${r1(g.size * 2 * PX)}px`,
                      `--ff-dot:${String(g.color)}`,
                      `background:radial-gradient(circle closest-side,${rgba(String(g.color), Number(g.intensity))} 0%,${rgba(String(g.color), Number(g.intensity) * 0.5)} 25%,${rgba(String(g.color), 0)} 100%)`,
                      `animation-duration:${r1(t.blink)}s`,
                      `animation-delay:${r1(t.blinkDelay)}s`,
                    ].join(';')}
                  />
                </span>
              )),
            )}
            {lights.map((l) => {
              const d = l.radius * 2 * PX;
              return (
                <span
                  class:list={['glow', { flicker: l.flicker === true, breathe: l.flicker === 'breathe' }]}
                  style={[
                    `left:${r1((l.col + l.glowAt[0]) * PX - d / 2)}px`,
                    `top:${r1((l.row - band!.from + l.glowAt[1]) * PX - d / 2)}px`,
                    `width:${r1(d)}px;height:${r1(d)}px`,
                    `background:radial-gradient(circle closest-side,${rgba(l.color, l.intensity)} 0%,${rgba(l.color, l.intensity * 0.45)} 35%,${rgba(l.color, l.intensity * 0.12)} 70%,${rgba(l.color, 0)} 100%)`,
                    `animation-delay:${phase(l)}s`,
                  ].join(';')}
                />
              );
            })}
          </div>
        )}
        {hasTitle && id === 'end' && (
          <div class="wrap band-title">
            <slot name="title" />
          </div>
        )}
      </div>
    )
  }
  {
    id !== 'end' && (
      <div
        class="zone"
        data-zone={parts ? '' : undefined}
        data-rows={parts ? parts.natural : undefined}
        style={parts ? `min-height:calc(${parts.natural} * var(--map-tile));background:${parts.images.join(',')}` : undefined}
      >
        <div class="wrap zone-content">
          {/* The title sits at the bottom of the band above (over the scene) on wide screens,
              and at the top of the content on narrow ones, where the scene is too small to cover. */}
          {hasTitle && (
            <div class:list={['zone-title', { 'over-band': bandImage }]}>
              <slot name="title" />
            </div>
          )}
          <slot />
        </div>
      </div>
    )
  }
</Tag>
