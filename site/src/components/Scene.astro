---
// Header scene: one image composed by scripts/build-ui.mjs from scripts/scene.mjs,
// with the knight walking the road to the dungeon gate. Purely decorative.
import scene from '../assets/ui/scene.png?url';
import knight from '../../../assets/kenney/tiny-dungeon/tile_0097.png?url';

const SCALE = 2;
const TILE = 16 * SCALE;
const COLS = 28;
const ROWS = 4;
---

<div class="scene" aria-hidden="true">
  <div class="scene-map" style={`width:${COLS * TILE}px;height:${ROWS * TILE}px;background-image:url(${scene})`}>
    <span class="scene-walker" style={`--tile:${TILE}px;--gate:${23 * TILE}px`}>
      <img src={knight} alt="" width={TILE} height={TILE} />
    </span>
  </div>
</div>
