---
import Base from '../layouts/Base.astro';
import Highlights from './Highlights.astro';
import SkillChip from './SkillChip.astro';
import SkillChips from './SkillChips.astro';
import WorldSection from './WorldSection.astro';
import moon from '../assets/moon.svg';
import rock from '../assets/ui/rock.png';
import Tile from './Tile.astro';
import Flag from './Flag.astro';
import { sectionIcons } from '../lib/sprites';
import { languages, loadContent, formatMonth, formatRange } from '../lib/content';

// One resume page. Rendered at /<lang>/ for every language, and at / for the default language.
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { ui, profile, experience, projects, education, categories, playable } = loadContent(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const languageName = (l: string) => new Intl.DisplayNames([l], { type: 'language' }).of(l) ?? l;
const contactLabel: Record<string, string> = { email: 'Email', github: 'GitHub', linkedin: 'LinkedIn' };

const sections = ['about', 'projects', 'experience', 'skills', 'education'] as const;

// The horizon treeline's size comes from its map file, so changing its rows/cols never stretches it.
const horizonFile = import.meta.glob<{ cols: number; rows: number }>('../../scenes/horizon.json', { eager: true, import: 'default' });
const horizon = horizonFile['../../scenes/horizon.json'] ?? { cols: 8, rows: 3 };
const horizonStyle = `--horizon-w:calc(${horizon.cols} * var(--map-tile));--horizon-h:calc(${horizon.rows} * var(--map-tile))`;
---

<Base lang={lang} title={`${profile.name} (${profile.preferredName}) · ${profile.headline}`} description={profile.about}>
  <a class="skip-link" href="#main">{ui.labels.skipToContent}</a>

  <nav class="site-nav" aria-label="Sections">
    <div class="wrap">
      <ul>
        {sections.map((s) => <li><a href={`#${s}`}>{ui.nav[s]}</a></li>)}
      </ul>
    </div>
  </nav>

  <header class="site-header" style={horizonStyle}>
    <span class="moon-glow" aria-hidden="true"></span>
    <img class="moon" src={moon.src} alt="" width="20" height="20" />
    <div class="wrap">
      <div class="panel">
      <div class="top">
        <div>
          <h1 class="name">
            {profile.name} <span class="preferred">({profile.preferredName})</span>
          </h1>
          <p class="headline">{profile.headline}</p>
        </div>
        <nav class="lang-switch" aria-label={ui.nav.language}>
          {
            languages.map((l) => (
              <a href={`${base}/${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>
                <Flag country={profile.languageFlags?.[l]} />
                {languageName(l)}
              </a>
            ))
          }
        </nav>
      </div>
      <ul class="contacts">
        {
          profile.contacts.map((c: { type: string; value: string; url: string }) => (
            <li>
              <span class="type">{contactLabel[c.type] ?? c.type}</span>
              <a href={c.url} rel={c.type === 'email' ? undefined : 'me noopener'}>{c.value}</a>
            </li>
          ))
        }
      </ul>
      <div class="actions">
        {
          profile.resumes.map((r) => (
            <a class="button" href={r.url} download={r.fileName}>
              {ui.nav.resume} · {ui.resume?.[r.kind] ?? r.kind}
            </a>
          ))
        }
        {
          playable ? (
            <a class="button play" href={`${base}/play/`}>
              {ui.nav.play}
            </a>
          ) : (
            <button class="button play" type="button" disabled>
              <Tile tile={['town', 117]} scale={1} />
              {ui.nav.play} · {ui.labels.soon}
            </button>
          )
        }
      </div>
      </div>
    </div>
  </header>

  <div class="world">
  <main id="main">
    <WorldSection id="about" class="about" labelledby="about-title">
      <h2 slot="title" id="about-title" class="section-title"><Tile tile={sectionIcons.about} />{ui.nav.about}</h2>
      <div class="panel">
        <p>{profile.about}</p>
      </div>
    </WorldSection>

    <WorldSection id="projects" labelledby="projects-title">
      <h2 slot="title" id="projects-title" class="section-title"><Tile tile={sectionIcons.projects} />{ui.nav.projects}</h2>
      <div class="entries">
        {
          projects.map((p) => (
            <article id={`proj-${p.id}`} class="entry panel">
              <h3>{p.name}</h3>
              <div class="meta">
                <span>
                  {p.status === 'in-progress' && <span class="tag">{ui.labels.inProgress} · </span>}
                  {formatRange(p.start, p.end, lang, ui)}
                </span>
              </div>
              <p class="summary">{p.summary}</p>
              <Highlights items={p.highlights} />
              <SkillChips skills={p.skills} />
              {(p.links.length > 0 || p.codeOnRequest) && (
                <div class="notes">
                  {p.links.map((l) => (
                    <a href={l.url} rel="noopener">
                      {l.type === 'github' ? `GitHub · ${ui.labels.source}` : l.url}
                    </a>
                  ))}
                  {p.codeOnRequest && <span class="tag">{ui.labels.codeOnRequest}</span>}
                </div>
              )}
            </article>
          ))
        }
      </div>
    </WorldSection>

    <WorldSection id="experience" labelledby="experience-title">
      <h2 slot="title" id="experience-title" class="section-title"><Tile tile={sectionIcons.experience} />{ui.nav.experience}</h2>
      <div class="entries">
        {
          experience.map((e) => (
            <article id={`exp-${e.id}`} class="entry panel">
              <h3>{e.org}</h3>
              <div class="meta">
                <span class="role">{e.title}</span>
                <span>
                  {formatRange(e.start, e.end, lang, ui)}
                  {e.location && (
                    <span class="place">
                      {' · '}
                      <Flag country={e.country} />
                      {e.location}
                    </span>
                  )}
                </span>
              </div>
              <p class="summary">{e.summary}</p>
              <Highlights items={e.highlights} />
              <SkillChips skills={e.skills} />
            </article>
          ))
        }
      </div>
    </WorldSection>

    <WorldSection id="skills" labelledby="skills-title">
      <h2 slot="title" id="skills-title" class="section-title"><Tile tile={sectionIcons.skills} />{ui.nav.skills}</h2>
      <div class="panel skill-groups">
        {
          categories.map((c) => (
            <div class="skill-group">
              <h3>{c.label}</h3>
              <ul class="chips">
                {c.skills.flatMap((s) => [s, ...s.children]).map((s) => (
                  <li>
                    <SkillChip
                      skill={s}
                      title={s.usedIn.length > 0 ? `${ui.labels.usedIn}: ${s.usedIn.map((u) => u.label).join(', ')}` : undefined}
                    />
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </WorldSection>

    <WorldSection id="education" labelledby="education-title">
      <h2 slot="title" id="education-title" class="section-title"><Tile tile={sectionIcons.education} />{ui.nav.education}</h2>
      <div class="entries">
        {
          education.map((e: any) => (
            <article id={`edu-${e.id}`} class="entry panel">
              <h3>{e.school}</h3>
              <div class="meta">
                <span class="role">{e.degree}</span>
                <span>
                  {e.expected && `${ui.labels.expected} `}
                  {formatMonth(e.end, lang, ui)}
                  {e.location && (
                    <span class="place">
                      {' · '}
                      <Flag country={e.country} />
                      {e.location}
                    </span>
                  )}
                </span>
              </div>
            </article>
          ))
        }
      </div>
    </WorldSection>
  </main>

  <WorldSection id="footer" as="footer" class="site-footer">
      <div class="plate">
        {profile.resumes.length > 0 && <p>{ui.labels.fullResume}</p>}
        {!playable && <p class="game-note"><Tile tile={['dungeon', 108]} />{ui.labels.comingSoon}</p>}
        <p class="credits">
          {ui.labels.art}: <a href="https://www.kenney.nl" rel="noopener">Kenney</a> (CC0) ·{' '}
          {ui.labels.font}: <a href="https://github.com/quiple/galmuri" rel="noopener">Galmuri</a> (OFL) ·{' '}
          <a href={`${profile.repo}/blob/master/CREDITS.md`} rel="noopener">{ui.labels.credits}</a>
        </p>
        <p>© {new Date().getFullYear()} {profile.name}</p>
      </div>
  </WorldSection>
  <WorldSection id="end" as="div" />
  <div class="page-end" style={`background-image:url(${rock.src})`} aria-hidden="true"></div>
  </div>

  <script>
    // Round each content zone up to whole map rows, so its repeated rows are never cut.
    // A row is 32 px × --map-s (see Base.astro), so this reruns when the window resizes.
    const zones = document.querySelectorAll<HTMLElement>('[data-zone]');
    const rowPx = () => 32 * (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--map-s')) || 1);
    const fit = (zone: HTMLElement, px = rowPx()) => {
      const rows = Math.max(Number(zone.dataset.rows), Math.ceil((zone.firstElementChild as HTMLElement).offsetHeight / px - 0.001));
      zone.style.height = `${rows * px}px`;
    };
    const observer = new ResizeObserver((entries) => {
      for (const e of entries) fit(e.target.parentElement as HTMLElement);
    });
    zones.forEach((z) => observer.observe(z.firstElementChild as Element));
    window.addEventListener('resize', () => zones.forEach((z) => fit(z)));

    // On tall screens the page can end before the last section reaches the top, so the
    // nav link would stop short. Add just enough rock below the map to let it scroll up.
    const pageEnd = document.querySelector<HTMLElement>('.page-end');
    const last = document.getElementById('education');
    const fitEnd = () => {
      if (!pageEnd || !last) return;
      const nav = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-h')) || 0;
      const current = pageEnd.offsetHeight;
      const below = document.documentElement.scrollHeight - current - (last.getBoundingClientRect().top + window.scrollY);
      const need = Math.max(0, Math.ceil(window.innerHeight - nav - below));
      if (need !== current) pageEnd.style.height = `${need}px`;
    };
    new ResizeObserver(fitEnd).observe(document.querySelector('.world')!);
    window.addEventListener('resize', fitEnd);
    fitEnd();
  </script>
</Base>
