---
import Base from '../../layouts/Base.astro';
import Highlights from '../../components/Highlights.astro';
import SkillChip from '../../components/SkillChip.astro';
import SkillChips from '../../components/SkillChips.astro';
import Scene from '../../components/Scene.astro';
import Tile from '../../components/Tile.astro';
import Flag from '../../components/Flag.astro';
import { sectionIcons } from '../../lib/sprites';
import { languages, loadContent, formatMonth, formatRange } from '../../lib/content';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const { ui, profile, experience, projects, education, categories } = loadContent(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const languageName = (l: string) => new Intl.DisplayNames([l], { type: 'language' }).of(l) ?? l;
const contactLabel: Record<string, string> = { email: 'Email', github: 'GitHub', linkedin: 'LinkedIn' };

const sections = ['about', 'projects', 'experience', 'skills', 'education'] as const;
---

<Base lang={lang} title={`${profile.name} (${profile.preferredName}) · ${profile.headline}`} description={profile.about}>
  <a class="skip-link" href="#main">{ui.labels.skipToContent}</a>

  <header class="site-header">
    <div class="wrap">
      <div class="top">
        <div>
          <h1 class="name">
            {profile.name} <span class="preferred">({profile.preferredName})</span>
          </h1>
          <p class="headline">{profile.headline}</p>
        </div>
        <nav class="lang-switch" aria-label={ui.nav.language}>
          {
            languages.map((l) => (
              <a href={`${base}/${l}/`} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>
                <Flag country={profile.languageFlags?.[l]} />
                {languageName(l)}
              </a>
            ))
          }
        </nav>
      </div>
      <ul class="contacts">
        {
          profile.contacts.map((c: { type: string; value: string; url: string }) => (
            <li>
              <span class="type">{contactLabel[c.type] ?? c.type}</span>
              <a href={c.url} rel={c.type === 'email' ? undefined : 'me noopener'}>{c.value}</a>
            </li>
          ))
        }
      </ul>
      {
        profile.resumes.length > 0 && (
          <div class="actions">
            {profile.resumes.map((r) => (
              <a class="button" href={r.url} download={r.fileName}>
                {ui.nav.resume} · {ui.resume?.[r.kind] ?? r.kind}
              </a>
            ))}
          </div>
        )
      }
    </div>
    <Scene />
  </header>

  <nav class="site-nav" aria-label="Sections">
    <div class="wrap">
      <ul>
        {sections.map((s) => <li><a href={`#${s}`}>{ui.nav[s]}</a></li>)}
      </ul>
    </div>
  </nav>

  <main id="main" class="wrap">
    <section id="about" class="about" aria-labelledby="about-title">
      <h2 id="about-title" class="section-title"><Tile tile={sectionIcons.about} />{ui.nav.about}</h2>
      <div class="panel">
        <p>{profile.about}</p>
      </div>
    </section>

    <section id="projects" aria-labelledby="projects-title">
      <h2 id="projects-title" class="section-title"><Tile tile={sectionIcons.projects} />{ui.nav.projects}</h2>
      <div class="entries">
        {
          projects.map((p) => (
            <article id={`proj-${p.id}`} class="entry panel">
              <h3>{p.name}</h3>
              <div class="meta">
                <span>
                  {p.status === 'in-progress' && <span class="tag">{ui.labels.inProgress} · </span>}
                  {formatRange(p.start, p.end, lang, ui)}
                </span>
              </div>
              <p class="summary">{p.summary}</p>
              <Highlights items={p.highlights} />
              <SkillChips skills={p.skills} />
              {(p.links.length > 0 || p.codeOnRequest) && (
                <div class="notes">
                  {p.links.map((l) => (
                    <a href={l.url} rel="noopener">
                      {l.type === 'github' ? `GitHub · ${ui.labels.source}` : l.url}
                    </a>
                  ))}
                  {p.codeOnRequest && <span class="tag">{ui.labels.codeOnRequest}</span>}
                </div>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section id="experience" aria-labelledby="experience-title">
      <h2 id="experience-title" class="section-title"><Tile tile={sectionIcons.experience} />{ui.nav.experience}</h2>
      <div class="entries">
        {
          experience.map((e) => (
            <article id={`exp-${e.id}`} class="entry panel">
              <h3>{e.org}</h3>
              <div class="meta">
                <span class="role">{e.title}</span>
                <span>
                  {formatRange(e.start, e.end, lang, ui)}
                  {e.location && (
                    <span class="place">
                      {' · '}
                      <Flag country={e.country} />
                      {e.location}
                    </span>
                  )}
                </span>
              </div>
              <p class="summary">{e.summary}</p>
              <Highlights items={e.highlights} />
              <SkillChips skills={e.skills} />
            </article>
          ))
        }
      </div>
    </section>

    <section id="skills" aria-labelledby="skills-title">
      <h2 id="skills-title" class="section-title"><Tile tile={sectionIcons.skills} />{ui.nav.skills}</h2>
      <div class="panel skill-groups">
        {
          categories.map((c) => (
            <div class="skill-group">
              <h3>{c.label}</h3>
              <ul class="chips">
                {c.skills.flatMap((s) => [s, ...s.children]).map((s) => (
                  <li>
                    <SkillChip
                      skill={s}
                      title={s.usedIn.length > 0 ? `${ui.labels.usedIn}: ${s.usedIn.map((u) => u.label).join(', ')}` : undefined}
                    />
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section id="education" aria-labelledby="education-title">
      <h2 id="education-title" class="section-title"><Tile tile={sectionIcons.education} />{ui.nav.education}</h2>
      <div class="entries">
        {
          education.map((e: any) => (
            <article id={`edu-${e.id}`} class="entry panel">
              <h3>{e.school}</h3>
              <div class="meta">
                <span class="role">{e.degree}</span>
                <span>
                  {e.expected && `${ui.labels.expected} `}
                  {formatMonth(e.end, lang, ui)}
                  {e.location && (
                    <span class="place">
                      {' · '}
                      <Flag country={e.country} />
                      {e.location}
                    </span>
                  )}
                </span>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      {profile.resumes.length > 0 && <p>{ui.labels.fullResume}</p>}
      <p class="game-note"><Tile tile={['dungeon', 108]} />{ui.labels.comingSoon}</p>
      <p>© {new Date().getFullYear()} {profile.name}</p>
    </div>
  </footer>
</Base>
