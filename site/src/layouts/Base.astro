---
import '../styles/global.css';
import pixelFont from 'galmuri/dist/Galmuri11-Bold.woff2?url';
import favicon from '../../../assets/kenney/tiny-dungeon/tile_0097.png?url';
import { languages, defaultLanguage } from '../lib/content';

interface Props {
  lang: string;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ? new URL(base + '/', Astro.site).href : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta name="theme-color" content="#1d1a2f" />
    <link rel="icon" type="image/png" href={favicon} />
    {site && <link rel="canonical" href={`${site}${lang}/`} />}
    {site && languages.map((l) => <link rel="alternate" hreflang={l} href={`${site}${l}/`} />)}
    {site && <link rel="alternate" hreflang="x-default" href={`${site}${defaultLanguage}/`} />}
    <link rel="preload" href={pixelFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Map scale: the page map (and the horizon) is drawn 1:1 from MAP_VIEW px wide up, and
      // shrinks with the window below that, so narrow screens see the same scene as a laptop.
      // Content scale: the content (text, cards, margins) shrinks less, from 1 at MAP_VIEW
      // down to UI_MIN at PHONE px and narrower. CSS reads them as --map-s and --ui-s (1 without JS).
      (() => {
        const MAP_VIEW = 1280;
        const PHONE = 390;
        const UI_MIN = 0.8;
        const root = document.documentElement;
        const set = () => {
          const w = root.clientWidth;
          const k = Math.min(1, Math.max(0, (w - PHONE) / (MAP_VIEW - PHONE)));
          root.style.setProperty('--map-s', String(Math.min(1, w / MAP_VIEW)));
          root.style.setProperty('--ui-s', String(UI_MIN + (1 - UI_MIN) * k));
        };
        set();
        addEventListener('resize', set);
        addEventListener('DOMContentLoaded', set); // after the scrollbar shows up
      })();
    </script>
    <style set:html={`@font-face{font-family:'Galmuri11';font-weight:700;font-display:swap;src:url('${pixelFont}') format('woff2')}`}></style>
  </head>
  <body>
    <slot />
    <script>
      // Smooth mouse-wheel scrolling (Lenis). A plain wheel moves in big jumps; this eases
      // between them. Touch and trackpads keep their native feel, and Lenis turns the
      // smoothing off when the visitor prefers reduced motion. Nav links still work:
      // Lenis handles the #anchors.
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';

      // Section links stop right below the sticky nav: html's scroll-padding-top is the nav's
      // height, and Lenis already takes scroll-padding into account (so no extra offset here).
      const nav = document.querySelector<HTMLElement>('.site-nav');
      document.documentElement.style.setProperty('--nav-h', `${Math.floor(nav?.getBoundingClientRect().height ?? 0)}px`);
      new Lenis({ autoRaf: true, lerp: 0.12, smoothWheel: true, anchors: true });
    </script>
  </body>
</html>
