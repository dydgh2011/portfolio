---
import '../styles/global.css';
import pixelFont from 'galmuri/dist/Galmuri11-Bold.woff2?url';
import favicon from '../../../assets/kenney/tiny-dungeon/tile_0097.png?url';
import { languages, defaultLanguage } from '../lib/content';

interface Props {
  lang: string;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ? new URL(base + '/', Astro.site).href : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta name="theme-color" content="#1d1a2f" />
    <link rel="icon" type="image/png" href={favicon} />
    {site && <link rel="canonical" href={`${site}${lang}/`} />}
    {site && languages.map((l) => <link rel="alternate" hreflang={l} href={`${site}${l}/`} />)}
    {site && <link rel="alternate" hreflang="x-default" href={`${site}${defaultLanguage}/`} />}
    <link rel="preload" href={pixelFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Map scale: the page map (and the horizon) is drawn 1:1 from MAP_VIEW px wide up, and
      // shrinks with the window below that, so narrow screens see the same scene as a laptop.
      // Content scale: the content (text, cards, margins) shrinks less, from 1 at MAP_VIEW
      // down to UI_MIN at PHONE px and narrower. CSS reads them as --map-s and --ui-s (1 without JS).
      (() => {
        const MAP_VIEW = 1280;
        const PHONE = 390;
        const UI_MIN = 0.8;
        const root = document.documentElement;
        const set = () => {
          const w = root.clientWidth;
          const k = Math.min(1, Math.max(0, (w - PHONE) / (MAP_VIEW - PHONE)));
          root.style.setProperty('--map-s', String(Math.min(1, w / MAP_VIEW)));
          root.style.setProperty('--ui-s', String(UI_MIN + (1 - UI_MIN) * k));
        };
        set();
        addEventListener('resize', set);
        addEventListener('DOMContentLoaded', set); // after the scrollbar shows up
      })();
    </script>
    <style set:html={`@font-face{font-family:'Galmuri11';font-weight:700;font-display:swap;src:url('${pixelFont}') format('woff2')}`}></style>
  </head>
  <body>
    <slot />
    <script>
      // Smooth mouse-wheel scrolling (Lenis). A plain wheel moves in big jumps; this eases
      // between them. Touch and trackpads keep their native feel, and Lenis turns the
      // smoothing off when the visitor prefers reduced motion. Nav links still work:
      // Lenis handles the #anchors.
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';

      // Section links stop right below the sticky nav: html's scroll-padding-top is the nav's
      // height, and Lenis already takes scroll-padding into account (so no extra offset here).
      const nav = document.querySelector<HTMLElement>('.site-nav');
      document.documentElement.style.setProperty('--nav-h', `${Math.floor(nav?.getBoundingClientRect().height ?? 0)}px`);
      const lenis = new Lenis({ autoRaf: true, lerp: 0.12, smoothWheel: true, anchors: true });

      // Keyboard: jump between the page's stops (elements with data-stop, in page order).
      //   Space            next stop; from the last one (or the page's end) back to the top
      //   ↓ / →            next stop
      //   ↑ / ←            the top of the current stop, or the previous one when already there
      // Keys are left alone while typing, on focused buttons (Space presses them), with
      // modifier keys, and while a dialog is open.
      const stops = [...document.querySelectorAll<HTMLElement>('[data-stop]')];
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
      const navH = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-h')) || 0;
      const maxScroll = () => document.documentElement.scrollHeight - innerHeight;
      // Where each stop lands: right below the nav (the first one: the very top).
      const topOf = (i: number) => (i === 0 ? 0 : Math.max(0, Math.min(maxScroll(), stops[i].getBoundingClientRect().top + scrollY - navH())));
      let pending: { index: number; until: number } | null = null; // the stop being scrolled to
      const current = () => {
        if (pending && performance.now() < pending.until) return pending.index;
        if (scrollY >= maxScroll() - 2) return stops.length - 1; // the last stops may not reach the nav
        let index = 0;
        stops.forEach((_, i) => {
          if (topOf(i) <= scrollY + 4) index = i;
        });
        return index;
      };
      const go = (index: number) => {
        pending = { index, until: performance.now() + 900 };
        lenis.scrollTo(topOf(index), { immediate: reduceMotion.matches, force: true });
      };
      addEventListener('keydown', (e) => {
        if (stops.length < 2 || e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
        if (document.querySelector('dialog[open]')) return;
        const target = e.target as HTMLElement;
        if (target.closest('input, textarea, select, [contenteditable]:not([contenteditable="false"])')) return;
        const i = current();
        if (e.key === ' ') {
          if (target.closest('button, summary, [role="button"]')) return;
          go(i >= stops.length - 1 ? 0 : i + 1);
        } else if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          if (i < stops.length - 1) go(i + 1);
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          const inside = !(pending && performance.now() < pending.until) && topOf(i) < scrollY - 4;
          if (inside) go(i);
          else if (i > 0) go(i - 1);
        } else return;
        e.preventDefault();
      });
    </script>
  </body>
</html>
